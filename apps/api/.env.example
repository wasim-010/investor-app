PORT=4000
APP_NAME=Soppiya Investor App
APP_BASE_DOMAIN=example.com
SOPPIYA_GRAPH_URL=https://graph.soppiya.com/
SOPPIYA_STORE_DOMAIN=store.example.com

# Store-scoped token from storeUserToken. Keep this server-side only.
SOPPIYA_STORE_TOKEN=

# Required for merchant dashboard API calls. In production this should be replaced
# by Soppiya signed install/session verification instead of a public frontend key.
MERCHANT_API_KEY=change-me-long-random-value

# Required for investor login sessions.
INVESTOR_SESSION_SECRET=change-me-at-least-32-random-bytes
INVESTOR_SESSION_TTL_SECONDS=1209600

# Comma-separated frontend origins allowed in local development.
CORS_ORIGINS=https://development.soppiya.com,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001,http://localhost:5173
